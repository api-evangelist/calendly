          "name": "Create event invitee",
          "request": {
            "name": "Create event invitee",
            "description": {
              "content": "Creates a new invitee for a scheduled event, effectively booking a meeting on behalf of the invitee. This is the core endpoint of the Scheduling API, enabling programmatic event creation without redirects, iframes, or the Calendly-hosted UI. Requires a paid Calendly plan.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "invitees"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"<uri>\",\n  \"start_time\": \"<dateTime>\",\n  \"invitee\": {\n    \"name\": \"<string>\",\n    \"email\": \"<email>\",\n    \"timezone\": \"<string>\"\n  },\n  \"questions_and_answers\": [\n    {\n      \"question_uuid\": \"<string>\",\n      \"answer\": \"<string>\"\n    },\n    {\n      \"question_uuid\": \"<string>\",\n      \"answer\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
