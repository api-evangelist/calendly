  "item": [
    {
      "name": "outgoing_communications",
      "item": [
        {
          "name": "List outgoing communications",
          "id": "5ffecf12-48b4-490f-95de-4791a798e4b7",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/outgoing_communications?organization=<uri>&count=20&min_created_at=<dateTime>&max_created_at=<dateTime>&page_token=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "outgoing_communications"
              ],
              "query": [
                {
                  "description": "(Required) Return outgoing communications from the organization associated with this URI",
                  "key": "organization",
                  "value": "<uri>"
                },
                {
                  "description": "The number of records to return",
                  "key": "count",
                  "value": "20"
                },
                {
                  "description": "Include outgoing communications that were created after this time (sample time format: \"2020-01-02T03:04:05.678Z\"). This time should use the UTC timezone",
                  "key": "min_created_at",
                  "value": "<dateTime>"
                },
                {
                  "description": "Include outgoing communications that were created prior to this time (sample time format: \"2020-01-02T03:04:05.678Z\"). This time should use the UTC timezone",
                  "key": "max_created_at",
                  "value": "<dateTime>"
                },
                {
                  "description": "The token to pass to get the next portion of the collection",
                  "key": "page_token",
                  "value": "<string>"
                }
              ]
            },
            "description": "> This endpoint requires an Enterprise subscription.\n\n> `outgoing_communications:read`\n\nReturns a list of outgoing SMS and email communications."
          },
